{
  "manifest_version": 3,
  "name": "Ultron — Privacy Guard for AI",
  "version": "2.1.0",
  "description": "Ultron — Blocks sensitive data before it reaches any AI. Text-only red highlight, vault, make prompt perfect. Works on ChatGPT/Claude/Gemini/Perplexity/AI Studio and any app with a prompt box.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://www.claude.ai/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://poe.com/*",
    "https://*.poe.com/*",
    "https://character.ai/*",
    "https://*.character.ai/*",
    "https://you.com/*",
    "https://*.you.com/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_title": "Ultron — Settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "public/icons/shield-16.png",
      "48": "public/icons/shield-48.png",
      "128": "public/icons/shield-128.png"
    }
  },
  "icons": {
    "16": "public/icons/shield-16.png",
    "48": "public/icons/shield-48.png",
    "128": "public/icons/shield-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://www.claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://poe.com/*",
        "https://*.poe.com/*",
        "https://character.ai/*",
        "https://*.character.ai/*",
        "https://you.com/*",
        "https://*.you.com/*",
        "https://huggingface.co/*",
        "https://*.huggingface.co/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/*", "public/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
